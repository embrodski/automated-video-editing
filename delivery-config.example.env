# Copy to a local .env or set in your shell before PIAB full render delivery.
# Never commit real secrets to git.

# Frame.io v4 (upload + public share)
# Native App OAuth: run `python scripts/harness_frameio_oauth.py login` once, then
# `python scripts/harness_frameio_discover.py --write-env`. Tokens refresh from
# `.frameio-oauth.json`; you do not paste access tokens here manually.
FRAMEIO_CLIENT_ID=47e70e7744c24ea3af17598e2f845192
FRAMEIO_ACCOUNT_ID=
FRAMEIO_PROJECT_ID=
FRAMEIO_UPLOAD_FOLDER_ID=

# Gmail SMTP (use an App Password — run: python scripts/harness_setup_smtp.py)
HARNESS_SMTP_HOST=smtp.gmail.com
HARNESS_SMTP_PORT=587
HARNESS_SMTP_USER=you@gmail.com
HARNESS_SMTP_PASSWORD=
HARNESS_SMTP_FROM=you@gmail.com
HARNESS_SMTP_USE_TLS=true
